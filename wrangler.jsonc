{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wtf-shed-happens",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ENGINE",
        "class_name": "MetabolicEngine"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MetabolicEngine"]
    }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
